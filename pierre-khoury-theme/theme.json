{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1400px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "page-bg", "name": "Page background", "color": "oklch(0.93 0.006 85)" },
				{ "slug": "surface", "name": "Surface", "color": "oklch(0.98 0.005 85)" },
				{ "slug": "surface-alt", "name": "Surface alt", "color": "oklch(0.955 0.008 85)" },
				{ "slug": "border", "name": "Border", "color": "oklch(0.89 0.01 85)" },
				{ "slug": "ink", "name": "Ink", "color": "oklch(0.15 0.02 262)" },
				{ "slug": "gray", "name": "Gray text", "color": "oklch(0.38 0.02 262)" },
				{ "slug": "navy", "name": "Navy", "color": "oklch(0.30 0.11 258)" },
				{ "slug": "navy-dark", "name": "Navy dark", "color": "oklch(0.24 0.09 258)" },
				{ "slug": "accent", "name": "Accent blue", "color": "oklch(0.55 0.18 258)" },
				{ "slug": "white", "name": "White", "color": "#ffffff" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Space Grotesk",
					"fontFamily": "'Space Grotesk', Helvetica, sans-serif"
				},
				{
					"slug": "editorial",
					"name": "Newsreader",
					"fontFamily": "Newsreader, Georgia, serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "13px" },
				{ "slug": "medium", "name": "Medium", "size": "16.5px" },
				{ "slug": "large", "name": "Large", "size": "21px" },
				{ "slug": "x-large", "name": "Extra Large", "size": "clamp(26px, 3.1cqw, 42px)" },
				{ "slug": "xx-large", "name": "XX Large", "size": "clamp(32px, 4.6cqw, 66px)" }
			]
		},
		"spacing": {
			"units": [ "px", "%", "em", "rem", "vh", "vw", "cqw" ],
			"padding": true,
			"margin": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page-bg)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "16.5px",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				":hover": { "color": { "text": "oklch(0.42 0.15 258)" } }
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.08"
				}
			},
			"button": {
				"typography": {
					"fontSize": "12px",
					"fontWeight": "700",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase"
				},
				"border": { "radius": "999px" },
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--navy)",
						"text": "#ffffff"
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
